# Virtual environments
.venv/
venv/
env/

# Environment / secrets: keys live in GitHub's "production" environment and
# the hosts' own secret settings, never in the repo.
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# Data and model artifacts. The built caches and trained models are committed
# so the deployed app starts without re-downloading 314 matches; the local
# leaderboard is per-machine state. The club shots (data/club_shots/) are only
# needed to retrain the xG models, so they stay local.
data/*
!data/*.parquet
data/leaderboard.json

